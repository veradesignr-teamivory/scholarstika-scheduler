# ── Required ───────────────────────────────────────────────
# Password you type to open the app.
ADMIN_PASSWORD=
# Any long random string. Vercel sends it to /api/cron so only Vercel can trigger posting.
CRON_SECRET=
# Your live address, e.g. https://scholarstika-scheduler.vercel.app (used for sign-in redirects)
APP_URL=

# ── Facebook Page + Instagram (from developers.facebook.com → your app → App settings → Basic)
META_APP_ID=
META_APP_SECRET=
# Optional: pick a specific Page if you manage several
FB_PAGE_ID=

# ── LinkedIn (from linkedin.com/developers → your app → Auth)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Optional: post as the Scholarstika company page instead of your profile.
# The number in your page's admin URL: linkedin.com/company/12345678/admin
# Needs LinkedIn's "Community Management API" product approved on your app.
LINKEDIN_ORG_ID=

# ── WordPress blog (scholarstika.org) ──────────────────────
# Your site's address, e.g. https://scholarstika.org
WP_URL=
# The WordPress username (not email) of an Administrator, Editor or Author
WP_USERNAME=
# WordPress → Users → Profile → Application Passwords → Add New (the 24-character code)
WP_APP_PASSWORD=
# "publish" (default) posts live; "draft" saves to WordPress for you to review first
WP_POST_STATUS=publish
# Optional: category ID for all blog posts (Posts → Categories, hover a category to see tag_ID)
WP_CATEGORY_ID=

# ── Added automatically when you connect storage in Vercel ──
# Upstash Redis (Vercel → Storage → Marketplace → Upstash Redis)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Vercel Blob (Vercel → Storage → Blob)
BLOB_READ_WRITE_TOKEN=

# ── Optional overrides ──────────────────────────────────────
# META_GRAPH_VERSION=v23.0
# LINKEDIN_API_VERSION=202608
# Paste tokens directly instead of using the Connect buttons:
# FB_PAGE_ACCESS_TOKEN=
# IG_USER_ID=
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_AUTHOR_URN=urn:li:person:xxxx
